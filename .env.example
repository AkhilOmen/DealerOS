# Copy to .env for local runs (uv run ...). Defaults in app/core/config.py match docker-compose.

ENVIRONMENT=DEVELOPMENT
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=dealeros
POSTGRES_PASSWORD=dealeros
POSTGRES_DB=dealeros

MQ_HOST=localhost
MQ_PORT=5672
MQ_USERNAME=dealeros
MQ_PASSWORD=dealeros
MQ_VHOST=dealeros
INTERNAL_CLIENT_ID=46e3210d-94ec-465b-9566-c60c5779efdc
INTERNAL_CLIENT_SECRET=change-me
API_HOST=0.0.0.0
API_PORT=8000

# Query planner. anthropic (default) or openai_compatible (e.g. Kimi):
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5.5
LLM_API_KEY=
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.moonshot.ai/v1
# LLM_MODEL=<kimi model id>

# The API's own non-owner database login (migration 1.3.0). To run the API locally with it:
#   POSTGRES_USER=dealeros_api POSTGRES_PASSWORD=$API_DB_PASSWORD uv run python -m app.api.main
API_DB_PASSWORD=dealeros_api
